# Copy to alloy.env (Git-ignored), fill in, then `just nix-push-secrets`.
# Values come from the Grafana Cloud stack: Prometheus/Loki "Details" and a
# Cloud access policy token with metrics:write and logs:write.
GRAFANA_PROM_URL=https://prometheus-XXX.grafana.net/api/prom/push
GRAFANA_PROM_USER=000000
GRAFANA_LOKI_URL=https://logs-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=000000
GRAFANA_TOKEN=glc_REPLACE_ME
